<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<style>

html,body{
    margin:0;
    padding:0;
    background:transparent;
    overflow:hidden;
}


/* 隐藏按钮（自动播放用） */
#musicButton{

    position:fixed;

    right:20px;

    bottom:20px;

    width:55px;

    height:55px;

    border-radius:50%;

    border:1px solid rgba(255,255,255,0.5);

    background:rgba(255,255,255,0.2);

    color:white;

    font-size:26px;

}

</style>

</head>


<body>


<audio id="bgMusic" 
       autoplay 
       loop 
       preload="auto">

<source 
src="https://h2027125863-lgtm.github.io/readymag-music1/flow.mp3"
type="audio/mpeg">

</audio>


<button id="musicButton">
♫
</button>



<script>


const music=document.getElementById("bgMusic");

const btn=document.getElementById("musicButton");


// 页面加载自动播放

window.onload=function(){

    music.play().then(()=>{

        btn.innerHTML="Ⅱ";

    }).catch(()=>{

        // 浏览器阻止自动播放

        btn.innerHTML="♫";

    });

};



// 点击备用

btn.onclick=function(){

if(music.paused){

    music.play();

    btn.innerHTML="Ⅱ";

}

else{

    music.pause();

    btn.innerHTML="♫";

}

};


</script>


</body>

</html>
